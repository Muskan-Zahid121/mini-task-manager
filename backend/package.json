{
  "name": "mini-task-manager-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express + Sequelize + PostgreSQL API for the Mini Task Manager",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx node_modules/sequelize-cli/lib/sequelize db:migrate",
    "db:migrate:undo": "tsx node_modules/sequelize-cli/lib/sequelize db:migrate:undo",
    "db:seed": "tsx node_modules/sequelize-cli/lib/sequelize db:seed:all",
    "db:reset": "tsx scripts/reset-database.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "sequelize": "^6.37.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "sequelize-cli": "^6.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
